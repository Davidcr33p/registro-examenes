rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo de academias y materias: nombres de materias, no son datos
    // sensibles. Abierto para que el panel de administración (admin.html)
    // se pueda usar para cargar la primera academia antes de que exista
    // ninguna cuenta de maestro (y para que el selector de academia del
    // registro de cuentas funcione antes de iniciar sesión).
    match /academias/{academiaId} {
      allow read, write: if true;
    }

    // Exámenes precargados por periodo. Los crea/borra solo un admin (es
    // una acción masiva de "generar periodo"); cualquier maestro logueado
    // puede leerlos y marcarlos entregado/pendiente.
    match /registros/{registroId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update: if request.auth != null;
    }

    // Perfiles de maestro: cada quien lee/edita solo el suyo; cualquier
    // maestro logueado puede leer los demás (para futuros usos, ej. listas).
    match /maestros/{maestroId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == maestroId;
    }

    // Lista de administradores: pueden generar el periodo de exámenes
    // (crear/borrar en registros/) y editar config/. La tabla de exámenes
    // para ellos es de solo lectura del lado de la app, no de las reglas.
    match /admins/{adminId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Configuración general (ej. periodo activo). Lectura para cualquier
    // maestro logueado, escritura solo para admins.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
